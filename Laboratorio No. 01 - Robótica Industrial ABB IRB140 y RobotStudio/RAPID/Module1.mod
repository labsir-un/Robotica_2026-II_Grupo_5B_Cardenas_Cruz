PROC ModoMantenimiento()
    MoveAbsJ PoseMant, v200, fine, MyNewTool; 
ENDPROC

PROC FarmearAura()
    VAR num i;
    Reset DO_01;
    Reset DO_02;
    Set DO_03;
    
    Path_Home;
    
    
    MoveAbsJ Pose_Aura1, v150, z1, MyNewTool;
    
    FOR i FROM 1 TO 3 DO
        MoveAbsJ Pose_Aura2, v150, z1, MyNewTool;
        MoveAbsJ Pose_Aura3, v150, z1, MyNewTool;
    ENDFOR
    
    MoveAbsJ Pose_Aura4, v150, fine, MyNewTool;
    Path_Home;
    Reset DO_03;
    
    WHILE DI_03 = 1 DO
        WaitTime 0.1;
    ENDWHILE
ENDPROC
    
