    !Tiempos de la banda 
    CONST num TiempoEntrada := 4.3;
    CONST num TiempoSalida := 4.3;
    
    ! Pose de mantenimiento y de farmeo de aura
    CONST jointtarget PoseMant :=[[-30,-10,10,0,30,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST robtarget Pivote:=[[-2.796,3.031,-102],[0.707106781,0,0,-0.707106781],[0,0,0,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST jointtarget Pose_Aura1:=[[-9.97,22.69,-26.9,14.96,-6,-2.72],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST jointtarget Pose_Aura2:=[[10,15,-10,0,20,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST jointtarget Pose_Aura3:=[[10,25,-5,0,30,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST jointtarget Pose_Aura4:=[[-20.82,-13.81,1.11,0,5.28,95.41],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
    CONST num TiempoDeslizamiento:=3.8;

    

    
    PROC main()
        Reset DO_01;
        Reset DO_02;
        Reset DO_03;
        Reset FWD_Conveyor;
        Reset BWD_Conveyor;
        Path_Home;
        
        WHILE TRUE DO
            
            IF DI_01=1 THEN
                Set DO_01;
                SET FWD_Conveyor;
                WaitTime TiempoEntrada;
                RESET FWD_Conveyor;
                RutinaDecoracion;
                SET FWD_Conveyor;
                WaitTime TiempoSalida;
                RESET FWD_Conveyor;
                Reset DO_01;
            ENDIF
            
            IF DI_02 = 1 THEN
                Set DO_02;
                Path_Home;
                WHILE DI_02 = 0 DO
                    ModoMantenimiento;
                ENDWHILE
                Path_Home;
                Reset DO_02;
            ENDIF
            
            IF DI_03 = 1 THEN
                Set DO_03;
                FarmearAura;
                Reset DO_03;
            ENDIF
            
        ENDWHILE
    ENDPROC
        
    

    
    PROC RutinaVuelta()
        IF DI_02 = 1 THEN
            Path_Home;
            Set BWD_Conveyor;
            WaitTime 4.3;
            Reset BWD_Conveyor;
        ENDIF
    ENDPROC
    

PROC RutinaDecoracion()
        
        ! Contornos principales y rostro
        Path_Home;
        Path_ContornoExterno; !1
        Path_Pausa;
