    PROC CicloDecoracion()
        ConveyorStop;
        ConveyorForward;
        ConveyorStop;
        WaitTime TiempoEntrada;
        ConveyorStop;
        WaitTime TiempoDeslizamiento;
        Set DO_01;
        RutinaDecoracion;
        Reset DO_01;
        Path_Home;
        ConveyorForward;
        ConveyorStop;
        WaitTime TiempoSalida;
        ConveyorStop;
        WaitTime TiempoDeslizamiento;
    ENDPROC
    PROC ConveyorForward()
        ConveyorStop;
        Reset BWD_Conveyor;
        WaitTime 0.2;
        ConveyorStop;
        Set FWD_Conveyor;
    ENDPROC
    PROC ConveyorBackward()
        ConveyorStop;
        Reset FWD_Conveyor;
        WaitTime 0.2;
        ConveyorStop;
        Set BWD_Conveyor;
    ENDPROC
    PROC ConveyorStop()
        Reset FWD_Conveyor;
        Reset BWD_Conveyor;
    ENDPROC
    
ENDMODULE